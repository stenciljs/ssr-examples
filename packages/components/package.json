{
  "name": "@ssr-examples/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --watch"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "1.6.0",
    "@stencil/core": "5.0.0-beta.36",
    "@stencil/react-output-target": "1.8.1",
    "@stencil/types-output-target": "1.1.0",
    "@types/react": "^19.3.0",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "vue": "^3.5.45",
    "@stencil/vue-output-target": "0.15.0"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/loader.d.ts",
      "import": "./dist/loader-bundle/esm/loader.js"
    },
    "./loader": {
      "types": "./dist/types/loader.d.ts",
      "import": "./dist/loader-bundle/esm/loader.js"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "import": "./dist/standalone/index.js"
    },
    "./demo-badge": {
      "types": "./dist/standalone/demo-badge.d.ts",
      "import": "./dist/standalone/demo-badge.js"
    },
    "./demo-card": {
      "types": "./dist/standalone/demo-card.d.ts",
      "import": "./dist/standalone/demo-card.js"
    },
    "./demo-counter": {
      "types": "./dist/standalone/demo-counter.d.ts",
      "import": "./dist/standalone/demo-counter.js"
    },
    "./demo-notice": {
      "types": "./dist/standalone/demo-notice.d.ts",
      "import": "./dist/standalone/demo-notice.js"
    },
    "./demo-stats": {
      "types": "./dist/standalone/demo-stats.d.ts",
      "import": "./dist/standalone/demo-stats.js"
    },
    "./demo-task-list": {
      "types": "./dist/standalone/demo-task-list.d.ts",
      "import": "./dist/standalone/demo-task-list.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    },
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json",
    "./ssr-prop": {
      "types": "./dist/ssr/ssr-prop.d.ts",
      "import": "./dist/ssr/ssr-prop.js"
    },
    "./react-native-types": {
      "types": "./dist/types/react-native-types.d.ts"
    },
    "./vue-native-types": {
      "types": "./dist/types/vue-native-types.d.ts"
    },
    "./svelte-native-types": {
      "types": "./dist/types/svelte-native-types.d.ts"
    },
    "./solid-native-types": {
      "types": "./dist/types/solid-native-types.d.ts"
    },
    "./astro-native-types": {
      "types": "./dist/types/astro-native-types.d.ts"
    }
  },
  "peerDependencies": {
    "@types/react": ">=19",
    "solid-js": ">=1",
    "svelte": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
