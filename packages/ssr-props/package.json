{
  "name": "@ssr-examples/ssr-props",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pass complex (non-attribute) props to server-rendered Stencil components from any framework's templates.",
  "scripts": {
    "build": "tsc -p ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
