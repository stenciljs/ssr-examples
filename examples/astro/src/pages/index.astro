---
import { stats, tasks } from '@ssr-examples/demo-data';
import { ssrProp } from '@ssr-examples/components/ssr-prop';

const framework = 'Astro';
const badge = 'SSR';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Astro · Stencil SSR</title>
    <style is:global>
      body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; }
      main > * { margin-bottom: 1.5rem; }
      .demo-notice { display: block; padding: .75rem 1rem; border-radius: 6px; background: #eef2ff; }
    </style>
  </head>
  <body>
    <main>
      <h1>{framework} + Stencil SSR</h1>
      <demo-notice kind="info">Rendered by {framework}.</demo-notice>
      <demo-card heading="Server-rendered card" variant="highlight">
        <span slot="icon">★</span>
        <p>This card was rendered on the server as Declarative Shadow DOM.</p>
        <demo-badge tone="success">{badge}</demo-badge>
        <span slot="footer">Footer slot</span>
      </demo-card>
      <demo-counter start={5} step={2}></demo-counter>
      <p id="last-count">Last count: none</p>
      <demo-task-list tasks={ssrProp(tasks)}></demo-task-list>
      <demo-stats stats={ssrProp(stats)}></demo-stats>
      <button id="add-stat" type="button">Add stat</button>
      <button id="update-badge" type="button">Update badge</button>
    </main>
    <script src="../scripts/client.ts"></script>
  </body>
</html>
