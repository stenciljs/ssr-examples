{
  "name": "@ssr-examples/example-sveltekit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3004 --strictPort",
    "build": "vite build",
    "start": "PORT=3004 node build/index.js",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@ssr-examples/components": "workspace:*",
    "@ssr-examples/demo-data": "workspace:*",
    "@ssr-examples/ssr-props": "workspace:*"
  }
}
